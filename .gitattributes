# Normalise line endings inside the repository, check out native endings per OS.
* text=auto

# Binary assets are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.db binary
*.woff binary
*.woff2 binary

# Windows-only shell scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
