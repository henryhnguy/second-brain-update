# ---------------------------------------------------------------------------
# Second Brain — example environment.
# Copy to `.env` and uncomment what you need. Every value here is optional:
# the app runs with no model configured and no connectors.
#
# These can also be set in the UI under Settings, where values are stored
# sealed with the local key and win over the environment.
# ---------------------------------------------------------------------------

# --- Where data lives ------------------------------------------------------
# Defaults to ./data next to the repository root.
# SB_REPO_ROOT=.
# SB_DATA_DIR=./data
# SB_DB_FILE=./data/brain.db
# SB_SECRET_FILE=./data/.secret

# --- Web server ------------------------------------------------------------
# PORT=4173
# SB_APP_URL=http://localhost:4173
# Public base URL used to build connector callback URLs. Set this when the app
# is reachable on anything other than http://localhost:4173.
# SB_PUBLIC_URL=http://localhost:4173

# --- Model provider (OpenAI-compatible) ------------------------------------
# One wire format covers OpenAI, OpenRouter, Groq, DeepSeek, Azure-style
# gateways, LM Studio and Ollama.
# SB_AI_MODE=auto                       # auto | openai_compatible | off
# SB_AI_BASE_URL=https://api.openai.com/v1
# SB_AI_CHAT_MODEL=gpt-4o-mini
# SB_AI_EMBED_MODEL=text-embedding-3-small
# SB_AI_EMBED_DIM=0                     # 0 = ask the provider
# SB_AI_TIMEOUT_MS=60000
# SB_AI_MAX_OUTPUT_TOKENS=2048
#
# The model key is read from the environment variable SB_AI_API_KEY, or paste
# it in Settings → AI provider (stored sealed, shown masked).

# Local models instead of a cloud API:
# SB_AI_BASE_URL=http://localhost:11434/v1        # Ollama
# SB_AI_CHAT_MODEL=llama3.1
# SB_AI_EMBED_MODEL=nomic-embed-text

# --- API access control ----------------------------------------------------
# The API is bound to loopback by default. Set this when exposing it, create a
# token in Settings → API token, and send `Authorization: Bearer <token>`.
# SB_API_REQUIRE_TOKEN=1
# SB_API_DISABLE_AUTH=0

# --- Connector OAuth apps --------------------------------------------------
# Each OAuth provider needs your own app registration. The variables are named
# SB_<PROVIDER>_CLIENT_ID and SB_<PROVIDER>_CLIENT_SECRET, for example:
#   SB_SLACK_CLIENT_ID
#   SB_SLACK_CLIENT_SECRET
#   SB_GMAIL_CLIENT_ID
#   SB_GMAIL_CLIENT_SECRET
#   SB_GOOGLE_CALENDAR_CLIENT_ID
#   SB_GOOGLE_CALENDAR_CLIENT_SECRET
#   SB_OUTLOOK_MAIL_CLIENT_ID
#   SB_OUTLOOK_MAIL_CLIENT_SECRET
# Notion authenticates with a pasted integration token instead of OAuth.
# See docs/connectors.md.

# Optional: a writing model for Studio (lessons, decks, mind maps). Defaults to SB_AI_CHAT_MODEL.
# SB_STUDIO_MODEL=nvidia/nemotron-3-super-120b-a12b:free
